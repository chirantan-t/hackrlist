# ===================================================================
# Dockerized Hackathon Team Management System - Environment Template
# Copy this file to .env and configure your secrets before deployment
# ===================================================================

# Application Environment (development, staging, production)
DEPLOY_ENVIRONMENT=development
IMAGE_TAG=1.0.0
DOCKERHUB_USERNAME=yourdockerhubusername

# Port Allocations
# Spring Boot backend port (defaults to 8082 locally to prevent 8080 collision with Jenkins)
APP_PORT=8082
SERVER_PORT=8082

# Frontend development port
FRONTEND_PORT=5173

# Nginx production entry port
NGINX_PORT=8081

# Database Configuration (MySQL 8.x)
MYSQL_DATABASE=hackathondb
MYSQL_USER=hackathon_user
MYSQL_PASSWORD=replace_with_strong_db_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Spring Boot Datasource Connection
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/hackathondb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=hackathon_user
SPRING_DATASOURCE_PASSWORD=replace_with_strong_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Bootstrap Seed Data (set to false in production)
APP_BOOTSTRAP_SEED_DATA=true

# Jenkins CI/CD Credentials Identifiers
JENKINS_DOCKERHUB_CREDENTIAL_ID=dockerhub-credentials
JENKINS_GIT_CREDENTIAL_ID=github-credentials
